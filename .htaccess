Options -MultiViews
RewriteEngine On

# Keep pages out of search results unless their canonical path is allowlisted.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, follow" "expr=%{REQUEST_URI} !~ m#^/(about|product-ewa|product-ewa-leadership|product-marketplace-growth|product-design-system)?/?$#"
</IfModule>


# Block direct public access to /vid/ and anything inside it.
RewriteRule ^img/?$ - [F,L]

# Block direct directory access to /img/ while allowing files inside it.
RewriteRule ^img/?$ - [F,L]

# Block direct directory access to /nc_assets/ while allowing files inside it.
RewriteRule ^nc_assets/?$ - [F,L]

# Redirect direct .html requests to clean URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Serve real files and directories normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve extensionless page URLs from matching .html files.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html
