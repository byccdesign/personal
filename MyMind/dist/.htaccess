Options -Indexes -MultiViews
RewriteEngine On

# Deny direct HTTP access to secrets, database exports, and backup files.
# PHP may still include config.php internally; only browser requests are blocked.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|config(?:\.[^.]+)?\.php|.*\.(?:sql|sqlite|sqlite3|db|bak|backup|old|orig|save|swp|tmp|log|ini))$">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/css application/javascript
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"

    <FilesMatch "\.(?:css|js|mjs|webp|png|jpe?g|gif|svg|woff2?|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Content-Security-Policy "frame-ancestors 'self' https://christine-uy.com https://www.christine-uy.com"
    </FilesMatch>
</IfModule>

# Keep the PHP API and built assets reachable as real files.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Public canvas slugs and editor routes are handled by the React app.
RewriteRule ^ index.html [L]
