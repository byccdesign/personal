Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "private, no-store"
</IfModule>

<FilesMatch "^(DEPLOYMENT\.md|TimeTracking-namecheap\.zip|\.htpasswd|.*\.json)$">
    Require all denied
</FilesMatch>

AuthType Basic
AuthName "Restricted Access"
# AuthUserFile must be a real absolute path (Apache resolves it at
# config-parse time, not request time), so it can't be computed dynamically.
# This picks the right absolute path per environment via the Host header,
# so the same .htaccess works locally and on the live cPanel server.
<If "%{HTTP_HOST} == 'timetracking.christine-uy.com'">
    AuthUserFile "/home/chrimmrd/public_html/TimeTracking/.htpasswd"
</If>
<Else>
    AuthUserFile "/opt/homebrew/var/www/personal/TimeTracking/.htpasswd"
</Else>
Require valid-user
