Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "private, no-store"
</IfModule>

<FilesMatch "^(DEPLOYMENT\.md|TimeTracking-namecheap\.zip|\.htpasswd|.*\.json)$">
    Require all denied
</FilesMatch>

AuthType Basic
AuthName "Restricted Access"
# AuthUserFile must be a real absolute path (resolved at config-parse time,
# not request time). The production LiteSpeed server didn't honor the
# <If>/<Else> conditional this used to have (it silently dropped the whole
# auth block), so this is hardcoded to the production path.
# For LOCAL testing only, temporarily swap this line to:
#   AuthUserFile "/opt/homebrew/var/www/personal/TimeTracking/.htpasswd"
#   AuthUserFile "/home/chrimmrd/public_html/TimeTracking/.htpasswd"
# then swap it back before deploying.
AuthUserFile "/opt/homebrew/var/www/personal/TimeTracking/.htpasswd"
Require valid-user
