Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "private, no-store"
</IfModule>

<FilesMatch "^(DEPLOYMENT\.md|TimeTracking-namecheap\.zip|\.htpasswd|.*\.json)$">
    Require all denied
</FilesMatch>

AuthType Basic
AuthName "Restricted Access"
# NOTE: AuthUserFile must be a real absolute path (Apache resolves it at
# config-parse time, before any request-time variables exist), so this path
# has to be updated to match wherever this .htaccess actually lives.
# Local dev path is set below; swap it for the production cPanel path before deploying.
AuthUserFile "/opt/homebrew/var/www/personal/TimeTracking/.htpasswd"
Require valid-user
